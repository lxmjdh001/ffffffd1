# Copy to .env, or run scripts/init-production.sh to generate local secrets.
APP_ENV=production
APP_URL=https://d1apk.com
APP_SECRET=
ADMIN_EMAIL=admin@d1apk.com
# Optional administrator login name; when set, takes precedence over ADMIN_EMAIL.
ADMIN_ACCOUNT=
ADMIN_PASSWORD=
CNAME_TARGET=dns.d1apk.com
# Optional exact first-party subdomains permitted for integration testing.
CUSTOM_DOMAIN_TEST_HOSTS=
ACME_EMAIL=admin@d1apk.com
POSTGRES_PASSWORD=
DATABASE_URL=
SERVER_ROLE=all
TRUSTED_PROXY_CIDRS=172.30.88.0/24
HTTP_ADDR=0.0.0.0:8088
DATA_DIR=/app/data
WEB_DIR=/app/web/dist

# Required on control/all servers in production.
CLAMAV_ADDR=clamav:3310

# Empty = local disk. For S3, provision a PRIVATE bucket before startup.
# Endpoint is host[:port], without https://. All download nodes share this bucket.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=d1apk
S3_REGION=us-east-1
S3_SECURE=true
# Only for A -> B local storage: SERVER_ROLE=control, S3_ENDPOINT empty.
REMOTE_STORAGE_URL=

# Public detail-page icons/screenshots only. Reuse PWA's R2 bucket if desired;
# D1 writes only d1apk/page-images/<environment>/... and never lists that bucket.
# This does NOT change private APK storage (S3_* above).
PAGE_IMAGE_R2_ENDPOINT=
PAGE_IMAGE_R2_ACCESS_KEY=
PAGE_IMAGE_R2_SECRET_KEY=
PAGE_IMAGE_R2_BUCKET=
PAGE_IMAGE_R2_PUBLIC_URL=

# Same merchant/API protocol as go7. Use its full submit.php URL or gateway origin.
# Notify/return URLs are generated from this application's APP_URL, never go7's.
FUTOON_API_URL=
FUTOON_PID=
FUTOON_KEY=
# USDT mainnet TRC20. No private key is required by this application.
# New orders use the administrator's platform-configured address, if set.
USDT_WALLET=
# tron = direct chain verification; uzf = the existing go7-compatible query API.
USDT_PROVIDER=tron
# bcrypt hash only; use cmd/hash-password with the password on standard input.
# Quote the hash in shell-loaded env files so '$' is not expanded.
USDT_ADDRESS_PASSWORD_HASH=
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=
# Existing remote /api/check URL and HMAC query secret; no UZF deployment needed.
# Leave both empty to keep USDT unavailable until the operator supplies them.
# In tron mode the optional legacy monitor remains a hint, verified on-chain.
USDT_MONITOR_URL=
USDT_MONITOR_SECRET=
# Legacy UZF HTTP only: enable explicitly after accepting unencrypted-response risk.
# This never relaxes HTTPS for other payment providers. Prefer HTTPS when available.
USDT_MONITOR_ALLOW_HTTP=false
# go7 aliases are accepted when the corresponding values above are empty:
# USDT_API_URL=      (alias of USDT_MONITOR_URL)
# USDT_API_SECRET=   (alias of USDT_MONITOR_SECRET)
# USDT_WALLET_ADDRESS= (alias of USDT_WALLET)
META_API_VERSION=v25.0

# Enable Google Cloud Web Risk API for paid-member domain monitoring.
GOOGLE_WEB_RISK_API_KEY=

# Only used by deploy/compose.download.yml: private/WireGuard address of B.
DOWNLOAD_PRIVATE_IP=10.42.0.20
