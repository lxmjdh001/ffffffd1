{
    email {$ACME_EMAIL}
    on_demand_tls {
        ask http://app:8088/internal/tls/ask
    }
}

https:// {
    tls {
        on_demand
    }
    @internal path /internal/*
    respond @internal 404
    reverse_proxy app:8088 {
        # Disable proxy response buffering so slow clients apply backpressure.
        # Completion means bytes written by B, not proof of installation.
        flush_interval 10ms
    }
}
